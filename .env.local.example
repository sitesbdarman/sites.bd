# ==========================================
# Domain & Hosting Platform - Environment
# Copy this file to .env.local and fill in
# only the values you actually use.
# ==========================================

# -------------------------
# App
# -------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SitesBD

# -------------------------
# Supabase
# -------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------
# deSEC DNS
# Server-side only. Use a dedicated API token rather than your account password.
# -------------------------
DESEC_BASE_URL=https://desec.io/api/v1
DESEC_API_TOKEN=

# -------------------------
# Email / SMTP
# -------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SitesBD

# -------------------------
# Domain / RDAP
# -------------------------
DOMAIN_PROVIDER=
DOMAIN_PROVIDER_API_KEY=
DOMAIN_PROVIDER_API_SECRET=

# -------------------------
# Payment
# -------------------------
PAYMENT_MODE=simulation
PAYMENT_GATEWAY=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# -------------------------
# Security / Rate limiting
# -------------------------
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# -------------------------
# Cloudinary - media/images
# Server-side secret must never be exposed to the browser
# -------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------
# Optional
# -------------------------
SENTRY_DSN=

# -------------------------
# Domain registration / registrar
# deSEC is used for DNS management; domain purchases require a registrar API.
# -------------------------
DOMAIN_REGISTRAR_PROVIDER=
DOMAIN_REGISTRAR_API_BASE_URL=
DOMAIN_REGISTRAR_API_KEY=
DOMAIN_REGISTRAR_API_SECRET=
DOMAIN_REGISTRAR_WEBHOOK_SECRET=

# -------------------------
# Domain Registrar (for real domain registration/purchase)
# Recommended provider: OpenSRS / Tucows
# Keep credentials server-side only.
# -------------------------
DOMAIN_REGISTRAR_PROVIDER=opensrs
OPENSRS_API_KEY=
OPENSRS_API_SECRET=
OPENSRS_API_BASE_URL=
OPENSRS_TEST_MODE=true

# Manual payment merchant numbers
NEXT_PUBLIC_BKASH_NUMBER=
NEXT_PUBLIC_NAGAD_NUMBER=
NEXT_PUBLIC_ROCKET_NUMBER=
ADMIN_HOST=admin.derotsites.bd
CRON_SECRET=
